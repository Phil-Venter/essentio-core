{
    "name": "essentio/core",
    "description": "A minimalist PHP micro-framework for people who prefer simple structure and full control—without the bloat, dogma, or dependency hell.",
    "license": "0BSD",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Essentio\\Core\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Extra/functions.php"
        ]
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "stable",
    "scripts": {
        "runner": "composer format && composer test",
        "format": "./vendor/bin/rector",
        "test": "./vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
