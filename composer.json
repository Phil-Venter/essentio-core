{
    "name": "essentio/core",
    "description": "A minimalist PHP micro-framework for people who prefer simple structure and full control—without the bloat, dogma, or dependency hell.",
    "license": "0BSD",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Essentio\\Core\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Extra/functions.php"
        ]
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "nette/php-generator": "^4.1",
        "nikic/php-parser": "^5.4",
        "pestphp/pest": "^3.8",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "stable",
    "scripts": {
        "runner": "composer format && composer test && composer build:base 'dist/base.php' && composer build:full 'dist/full.php'",
        "format": "./vendor/bin/rector",
        "test": "./vendor/bin/pest",
        "build:base": "php bin/build.php --",
        "build:full": "php bin/build.php --extra --"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
